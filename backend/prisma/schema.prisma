// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  habits         Habit[]
  habitStatuses  HabitStatus[]
  taskCategories TaskCategory[]
  pointLogs      PointLog[]
  rewards        Reward[]
  redemptions    RedemptionLog[]
  goals          PointsGoal[]
  habitConnections HabitTaskConnection[]

  @@map("users")
}

model Habit {
  id          String   @id @default(cuid())
  name        String
  description String?
  repeatDays  String   // JSON string of number array [0,1,2,3,4,5,6]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  statuses    HabitStatus[]
  connections HabitTaskConnection[]

  @@map("habits")
}

model HabitStatus {
  id       String @id @default(cuid())
  habitId  String
  date     String // YYYY-MM-DD format
  status   String // 'success' | 'failure' | 'skipped' | 'pending'
  createdAt DateTime @default(now())

  // Relations
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_statuses")
}

model TaskCategory {
  id               String   @id @default(cuid())
  name             String
  description      String?
  defaultPointValue Int
  color            String
  priority         Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointLogs  PointLog[]
  connections HabitTaskConnection[]

  @@map("task_categories")
}

model PointLog {
  id             String   @id @default(cuid())
  categoryId     String
  description    String
  tasksCompleted Int
  pointsPerTask  Int
  totalPoints    Int
  date           String   // YYYY-MM-DD format
  createdAt      DateTime @default(now())

  // Relations
  category TaskCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_logs")
}

model Reward {
  id          String   @id @default(cuid())
  title       String
  description String
  cost        Int
  imageUrl    String?
  showImage   Boolean  @default(true)
  columnWidth Int      @default(1)
  priority    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptions RedemptionLog[]

  @@map("rewards")
}

model RedemptionLog {
  id           String   @id @default(cuid())
  rewardId     String
  rewardTitle  String
  pointsSpent  Int
  date         String   // YYYY-MM-DD format
  createdAt    DateTime @default(now())

  // Relations
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("redemption_logs")
}

model PointsGoal {
  id           String   @id @default(cuid())
  title        String
  targetPoints Int
  startDate    String   // YYYY-MM-DD format
  endDate      String   // YYYY-MM-DD format
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points_goals")
}

model HabitTaskConnection {
  id       String   @id @default(cuid())
  habitId  String
  taskId   String
  createdAt DateTime @default(now())

  // Relations
  habit Habit        @relation(fields: [habitId], references: [id], onDelete: Cascade)
  task  TaskCategory @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, taskId])
  @@map("habit_task_connections")
} 